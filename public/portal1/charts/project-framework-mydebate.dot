digraph framework { graph [bgcolor="#fafbf9", pad="0.35", nodesep="0.35", ranksep="0.42", fontname="DejaVu Sans", fontsize=23, fontcolor="#173d31", labelloc=t]; node [shape=box, style="rounded,filled", fillcolor="white", color="#759386", penwidth=1.5, fontname="DejaVu Sans", fontsize=15, fontcolor="#193b31", margin="0.20,0.13"]; edge [color="#477763", penwidth=1.7, arrowsize=0.75, fontname="DejaVu Sans", fontsize=12, fontcolor="#264f40"];
label="PROJECT FRAMEWORK + MyDEBATE\nProposed integration for community discussion";
a [label="IDEATE\nMembers propose ideas"];
b [label="SHORTLIST\nMembers choose ideas to examine"];
a -> b;
subgraph cluster_debate { label="CHALLENGE, supported by MyDebate"; style="rounded,filled"; fillcolor="#edf5f0"; color="#3f8065"; fontsize=19;
c [label="Break each proposal into specific points"];
d [label="People debate each point\nClaims, objections, evidence and responses"];
e [label="AI moderates and maintains the shared record\nKeeps discussion on topic and flags unanswered points",fillcolor="#e9f2fc"];
f [label="Give every point an explicit outcome\nInclude unresolved disagreements and next steps"];
c -> d -> e -> f; }
b -> c;
g [label="REFINE\nRevise the proposal using the discussion record"];
h [label="FINAL VOTE\nMembers decide with outcomes and objections visible",fillcolor="#fff0d5"];
i [label="SCOPE, TEAM AND TEST\nTest assumptions and unresolved factual questions"];
j [shape=diamond,label="Demand test\npasses?",fillcolor="#fff0d5"];
k [label="BUILD AND ITERATE"];
l [label="REVIEW\nImprove, backlog or stop"];
f -> g -> h -> i -> j;
j -> k [label="Yes"]; j -> l [label="No"]; k -> l;
l -> c [style=dashed,label="New evidence can reopen\na specific point",constraint=false];
}