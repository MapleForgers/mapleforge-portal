digraph protocol { graph [bgcolor="#fafbf9", pad="0.35", nodesep="0.35", ranksep="0.42", fontname="DejaVu Sans", fontsize=23, fontcolor="#173d31", labelloc=t]; node [shape=box, style="rounded,filled", fillcolor="white", color="#759386", penwidth=1.5, fontname="DejaVu Sans", fontsize=15, fontcolor="#193b31", margin="0.20,0.13"]; edge [color="#477763", penwidth=1.7, arrowsize=0.75, fontname="DejaVu Sans", fontsize=12, fontcolor="#264f40"];
label="INSIDE MyDEBATE\nPeople debate. People decide. AI moderates.";
a [label="STATE ONE SPECIFIC POINT\nWhat are we proposing or claiming?"];
b [label="People add reasons, evidence and objections"];
c [label="Keep responses attached to that point\nNew topics become separate linked points"];
d [shape=diamond,label="Has every objection received\na substantive response?",fillcolor="#fff0d5"];
a -> b -> c -> d;
e [label="AI flags the unanswered objection\nReturns attention to the specific question",fillcolor="#e9f2fc"];
d -> e [label="No"]; e -> b;
f [shape=diamond,label="Can participants reach\nan explicit outcome?",fillcolor="#fff0d5"];
d -> f [label="Yes"];
g [label="Record the outcome and reasons\nAccept, reject, revise or compromise"];
h [label="Identify the exact disagreement\nFacts, priorities, meaning or trade-offs"];
f -> g [label="Yes"]; f -> h [label="No"];
i [label="People agree how to judge it\nEvidence, test, criteria or decision rule\nAI helps clarify options and mediate",fillcolor="#e9f2fc"];
h -> i;
j [shape=diamond,label="Can it be\nresolved now?",fillcolor="#fff0d5"];
i -> j; j -> b [label="Yes",constraint=false];
k [label="Record it as unresolved\nKeep the objection visible\nSpecify the next step and how a decision will be made"];
j -> k [label="No"];
l [label="ONE SHARED ARGUMENT RECORD\nPoint + arguments + responses + outcome + reasons",fillcolor="#deeee4",penwidth=2.5];
g -> l; k -> l;
m [shape=diamond,label="Does every point have a recorded\noutcome or explicit next step?",fillcolor="#fff0d5"];
l -> m;
n [label="Return to outstanding points"];
m -> n [label="No"]; n -> a [constraint=false];
o [label="READY FOR REFINEMENT\nAND THE COMMUNITY'S DECISION",fillcolor="#deeee4"];
m -> o [label="Yes"];
p [shape=plain,label="A point can remain disputed. It cannot silently disappear.\nProposal: judgment criteria, deadlines and decision rules remain to be agreed.",fontsize=13];
o -> p [style=invis];
}