[Unit]
Description=MapleForge public Perspectives comments
After=network.target
[Service]
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/mapleforge-perspectives/perspectives_comments.py
Environment=PERSPECTIVES_DB=/var/lib/mapleforge-perspectives/comments.sqlite3
Environment=PERSPECTIVES_THREADS=/opt/mapleforge-perspectives/perspectives_threads.json
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mapleforge-perspectives
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
